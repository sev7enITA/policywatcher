# PolicyWatcher v3.5.1 Environment Configuration

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Keep demo AI fallback disabled in production. When false/unset, missing or
# failed Gemini analysis blocks ingestion instead of creating mock analysis.
ALLOW_DEMO_AI_FALLBACK=

# SMTP Configuration (Email Notifications)
# Works with any SMTP provider: Gmail, SendGrid, Postfix, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PolicyWatcher <noreply@policywatcher.app>"
# Operational recipient for source suspensions, Dataset QA anomalies, and new
# privacy-minimized Policy Inquiry tickets. The canonical queue remains
# /admin/inquiries even when SMTP is not configured.
# Falls back to ADMIN_EMAIL or SMTP_USER if unset.
ADMIN_ALERT_EMAIL=
ADMIN_EMAIL=

# Security
# High-entropy bearer token for cron/scrape/health operational endpoints.
# Generate a unique value for every environment. Do not reuse examples from docs or scripts.
API_SECRET=
# Mandatory, separate high-entropy secret for admin session cookies.
# Do not reuse API_SECRET; cron bearer tokens must never be able to sign admin sessions.
SESSION_HMAC_SECRET=

# Enterprise API v2 / Microsoft Entra ID
# Comma-separated accepted API audiences. Usually the Entra application client
# ID and/or its Application ID URI (for example api://<client-id>).
POLICYWATCHER_ENTRA_AUDIENCES=
# Pilot tenants as comma-separated Entra tenant UUIDs. Use * only after the
# multi-tenant consent and entitlement flow has been implemented and reviewed.
POLICYWATCHER_ENTRA_ALLOWED_TENANTS=
# Optional overrides. The defaults are policywatcher.read and PolicyWatcher.Read.All.
POLICYWATCHER_ENTRA_READ_SCOPES=
POLICYWATCHER_ENTRA_READ_ROLES=
# Public APIM gateway URL used by the generated OpenAPI server declaration.
POLICYWATCHER_ENTERPRISE_API_URL=
# Optional high-entropy secret injected by APIM as X-PolicyWatcher-Gateway-Key.
# When set, direct origin calls are rejected even if they carry a valid Entra token.
POLICYWATCHER_APIM_SHARED_SECRET=

# Configured webhook delivery pilot. Destinations are deployment-controlled;
# the application does not expose public endpoint registration. The JSON value
# is an array of up to 10 entries:
# [{"id":"grc-pilot","url":"https://receiver.example/webhooks/policywatcher","secret":"at-least-32-random-characters","startAt":"2026-07-30T00:00:00.000Z","locale":"en","active":true}]
# Every destination origin must also appear exactly in the comma-separated
# HTTPS allowlist. Keep both values in the hosting secret store, not in source.
POLICYWATCHER_WEBHOOK_ENDPOINTS_JSON=
POLICYWATCHER_WEBHOOK_ALLOWED_ORIGINS=

# Rendered-fetch strategy (optional but strongly recommended)
# URL + bearer secret of the Playwright renderer service (see renderer/README.md)
# deployed on your VPS. When unset, the scraper skips the rendered strategy
# and falls back to the archives (Wayback / Common Crawl).
RENDERER_URL=
RENDERER_SECRET=
# Previous secret is accepted only during a bounded rotation overlap. Remove it
# after the application has switched to the current RENDERER_SECRET.
RENDERER_SECRET_PREVIOUS=
# Required by renderer 1.2: comma-separated registrable domains that can be
# rendered. Wildcards and public suffixes are rejected; subdomains are covered
# by their registrable domain entry.
RENDERER_ALLOWED_DOMAINS=
# Optional third-party registrable domains required by scripts/XHR for an
# allowlisted target. Same-site subresources are already allowed.
RENDERER_SUBRESOURCE_ALLOWED_DOMAINS=
# Optional renderer-only override. Leave unset to use Playwright Chromium's
# native, version-coherent User-Agent (recommended).
RENDER_USER_AGENT=
# Bounded renderer limits. HTTP targets remain disabled unless explicitly
# enabled in a controlled non-production environment.
RENDER_TOTAL_TIMEOUT_MS=70000
MAX_HTML_BYTES=5000000
# Optional URL used by the admin VPS smoke check. Defaults to APP_URL.
VPS_RENDERER_SMOKE_URL=

# VPS Operations Agent (optional). Separate from the renderer service.
# Used by the admin panel for fixed smoke checks, backups, verified local
# package updates and rollback. Generate a dedicated high-entropy secret.
VPS_AGENT_URL=
VPS_AGENT_SECRET=

# Application
# Production must set both values exactly to https://policywatcher.online.
# The www hostname is a redirect-only alias and must never generate public URLs.
# Local development can keep the localhost values below.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Verified browser-store destinations. Chrome has a built-in official fallback;
# set the published Edge listing URL to expose its direct install action. Every
# value must be a credential-free HTTPS URL on chromewebstore.google.com,
# microsoftedge.microsoft.com or apps.apple.com.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
NEXT_PUBLIC_EDGE_EXTENSION_URL=
NEXT_PUBLIC_SAFARI_EXTENSION_URL=

# SQLite database. In production prefer an absolute path outside the extracted
# app source directory, e.g. file:/home/USER/domains/policywatcher.online/policywatcher-data/production.db
# For local development this resolves to prisma/dev.db.
DATABASE_URL=file:./dev.db

# Development-only database setup endpoint. Leave unset in production.
ALLOW_DATABASE_SEED_ENDPOINT=
# Controlled non-production tools/tests only. Leave unset in production so
# admin mutations without trustworthy Origin or Fetch Metadata fail closed.
ADMIN_MUTATION_ALLOW_MISSING_PROVENANCE=
# Development only. When unset/false, public APIs hide records whose current
# evidence is still seeded rather than retrieved from a source.
ALLOW_SEEDED_PUBLIC_DATA=
# Optional editorial layer. Keep unset in production until static KPI notes
# have been separately reviewed against current provider sources.
NEXT_PUBLIC_ALLOW_STATIC_KPI_JUSTIFICATIONS=

# Rate-limit identity. Leave unset unless your proxy is verified to overwrite forwarded headers.
TRUST_PROXY_HEADERS=
TRUSTED_CLIENT_IP_HEADER=

# Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_strong_admin_password
AUDITOR_USER=auditor
AUDITOR_PASSWORD=your_auditor_password
