# PolicyWatcher v3.5.1 Environment Configuration

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Keep demo AI fallback disabled in production. When false/unset, missing or
# failed Gemini analysis blocks ingestion instead of creating mock analysis.
ALLOW_DEMO_AI_FALLBACK=

# SMTP Configuration (Email Notifications)
# Works with any SMTP provider: Gmail, SendGrid, Postfix, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PolicyWatcher <noreply@policywatcher.app>"
# Operational recipient for source suspensions, Dataset QA anomalies, and new
# privacy-minimized Policy Inquiry tickets. The canonical queue remains
# /admin/inquiries even when SMTP is not configured.
# Falls back to ADMIN_EMAIL or SMTP_USER if unset.
ADMIN_ALERT_EMAIL=
ADMIN_EMAIL=

# Security
# High-entropy bearer token for cron/scrape/health operational endpoints.
# Generate a unique value for every environment. Do not reuse examples from docs or scripts.
API_SECRET=
# Mandatory, separate high-entropy secret for admin session cookies.
# Do not reuse API_SECRET; cron bearer tokens must never be able to sign admin sessions.
SESSION_HMAC_SECRET=

# Rendered-fetch strategy (optional but strongly recommended)
# URL + bearer secret of the Playwright renderer service (see renderer/README.md)
# deployed on your VPS. When unset, the scraper skips the rendered strategy
# and falls back to the archives (Wayback / Common Crawl).
RENDERER_URL=
RENDERER_SECRET=
# Optional URL used by the admin VPS smoke check. Defaults to APP_URL.
VPS_RENDERER_SMOKE_URL=

# VPS Operations Agent (optional). Separate from the renderer service.
# Used by the admin panel for fixed smoke checks, backups, verified local
# package updates and rollback. Generate a dedicated high-entropy secret.
VPS_AGENT_URL=
VPS_AGENT_SECRET=

# Application
# Your production domain (used in email links)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite database. In production prefer an absolute path outside the extracted
# app source directory, e.g. file:/home/USER/domains/policywatcher.online/policywatcher-data/production.db
# For local development this resolves to prisma/dev.db.
DATABASE_URL=file:./dev.db

# Development-only database setup endpoint. Leave unset in production.
ALLOW_DATABASE_SEED_ENDPOINT=
# Development only. When unset/false, public APIs hide records whose current
# evidence is still seeded rather than retrieved from a source.
ALLOW_SEEDED_PUBLIC_DATA=
# Optional editorial layer. Keep unset in production until static KPI notes
# have been separately reviewed against current provider sources.
NEXT_PUBLIC_ALLOW_STATIC_KPI_JUSTIFICATIONS=

# Rate-limit identity. Leave unset unless your proxy is verified to overwrite forwarded headers.
TRUST_PROXY_HEADERS=
TRUSTED_CLIENT_IP_HEADER=

# Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_strong_admin_password
AUDITOR_USER=auditor
AUDITOR_PASSWORD=your_auditor_password
