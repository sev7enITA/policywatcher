datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Company {
  id                        String                     @id @default(uuid())
  name                      String                     @unique
  slug                      String                     @unique
  logo                      String? // Hex color for brand identity
  industry                  String // "Tech Giant" or "FinTech"
  website                   String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  policies                  Policy[]
  policyDiscoveryCandidates PolicyDiscoveryCandidate[]
  policyDiscoveryJob        PolicyDiscoveryJob?
  sourceOnboardingItems     SourceOnboardingItem[]
}

model PolicyDiscoveryJob {
  id             String    @id @default(uuid())
  companyId      String    @unique
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runToken       String    @unique
  status         String    @default("running") // running, completed, failed
  startedAt      DateTime
  completedAt    DateTime?
  candidateCount Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, startedAt])
}

model PolicyInquiry {
  id               String    @id @default(uuid())
  publicToken      String    @unique
  dedupeKey        String
  activeDedupeKey  String?   @unique // Present only while the inquiry is active; closes concurrent-create races
  status           String    @default("Proposed") // Proposed, Approved, Rejected, Duplicate, Onboarding, Resolved
  kind             String // unknown_company, verify_existing
  companyHint      String?
  normalizedDomain String?
  sourceUrl        String?
  noticeDate       DateTime?
  effectiveDate    DateTime?
  policyTypesJson  String?
  matchedCompanyId String?
  matchedPolicyId  String?
  resolvedChangeId String?
  adminNote        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([dedupeKey])
  @@index([matchedCompanyId])
}

model PolicyDiscoveryCandidate {
  id                    String                 @id @default(uuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  type                  String
  url                   String
  jurisdiction          String                 @default("Global")
  confidence            Int
  discoverySource       String
  retrievalSource       String
  reason                String
  diagnosticsJson       String?
  status                String                 @default("Proposed") // Proposed, Approved, Rejected
  reviewedAt            DateTime?
  reviewedByRole        String?
  createdPolicyId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sourceOnboardingItems SourceOnboardingItem[]

  @@unique([companyId, url, type, jurisdiction])
  @@index([companyId, status])
  @@index([createdAt])
}

model Policy {
  id                      String                      @id @default(uuid())
  companyId               String
  company                 Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String // e.g. "Privacy Policy", "Terms of Service"
  type                    String // e.g. "privacy", "terms", "ai", "acceptable-use"
  url                     String
  retrievalUrl            String? // Optional official machine-readable mirror/PDF; url remains the public canonical link
  jurisdiction            String                      @default("Global") // "EU", "US", "UK", "Global", etc.
  currentText             String
  currentHash             String
  dataStatus              String                      @default("Available") // "Configured", "Available", "Partial", "Needs Review", "Unavailable", "Reviewed"
  lastCheckDate           DateTime                    @default(now())
  lastSuccessfulCheckDate DateTime                    @default(now())
  ingestionMethod         String                      @default("Seeded") // "Seeded", "Direct Scrape", "Wayback Cache", etc.
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  snapshots               PolicySnapshot[]
  changes                 PolicyChange[]
  checkLogs               PolicyCheckLog[]
  historicalReferences    HistoricalSourceReference[]
  sourceOnboardingItems   SourceOnboardingItem[]

  @@unique([companyId, type, jurisdiction])
  @@index([companyId])
  @@index([jurisdiction])
}

model PolicyCheckLog {
  id                String           @id @default(uuid())
  policyId          String
  policy            Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status            String // "Available", "Needs Review", "Unavailable", "Partial", "Configured", "Reviewed"
  checkedAt         DateTime         @default(now())
  source            String? // "direct", "http2", "wayback", "cache", "commoncrawl", "seeded", "none"
  httpStatus        Int?
  reason            String?
  finalUrl          String?
  textHash          String?
  textLength        Int?
  archiveTimestamp  DateTime?
  reasonCode        String?
  durationMs        Int?
  scanRunId         String?
  scanRun           ScanRun?         @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  sourceRetrievalId String?
  sourceRetrieval   SourceRetrieval? @relation(fields: [sourceRetrievalId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([policyId])
  @@index([checkedAt])
  @@index([status])
  @@index([scanRunId])
  @@index([sourceRetrievalId])
}

model ScanRun {
  id                       String            @id @default(uuid())
  status                   String            @default("running") // running, completed, failed
  startedAt                DateTime          @default(now())
  completedAt              DateTime?
  selectedRecords          Int               @default(0)
  uniqueSources            Int               @default(0)
  networkRetrievals        Int               @default(0)
  deduplicatedRetrievals   Int               @default(0)
  uniqueAvailableSources   Int               @default(0)
  uniqueUnavailableSources Int               @default(0)
  unavailableRecords       Int               @default(0)
  invalidRecords           Int               @default(0)
  partialRecords           Int               @default(0)
  errorRecords             Int               @default(0)
  metricsJson              String?
  optionsJson              String?
  createdAt                DateTime          @default(now())
  sourceRetrievals         SourceRetrieval[]
  checkLogs                PolicyCheckLog[]

  @@index([startedAt])
  @@index([status])
}

model SourceRetrieval {
  id                   String                      @id @default(uuid())
  scanRunId            String
  scanRun              ScanRun                     @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  retrievalKey         String
  requestedUrl         String
  archiveNotBefore     DateTime?
  status               String
  source               String?
  httpStatus           Int?
  durationMs           Int                         @default(0)
  reasonCode           String?
  reason               String?
  finalUrl             String?
  archiveTimestamp     DateTime?
  attemptsJson         String?
  createdAt            DateTime                    @default(now())
  checkLogs            PolicyCheckLog[]
  historicalReferences HistoricalSourceReference[]

  @@unique([scanRunId, retrievalKey])
  @@index([retrievalKey, createdAt])
  @@index([status])
}

model SourceRemediationIssue {
  id                    String    @id @default(uuid())
  retrievalKey          String    @unique
  sourceUrl             String
  status                String    @default("Watching") // Watching, Open, Recovered, Resolved
  reasonCode            String?
  affectedPolicyIdsJson String    @default("[]")
  totalFailures         Int       @default(0)
  consecutiveFailures   Int       @default(0)
  firstDetectedAt       DateTime  @default(now())
  lastDetectedAt        DateTime  @default(now())
  recoveredAt           DateTime?
  resolvedAt            DateTime?
  suggestedAction       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, lastDetectedAt])
  @@index([reasonCode])
}

model HistoricalSourceReference {
  id                         String           @id @default(uuid())
  policyId                   String
  policy                     Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sourceRetrievalId          String?
  sourceRetrieval            SourceRetrieval? @relation(fields: [sourceRetrievalId], references: [id], onDelete: SetNull)
  source                     String
  referenceUrl               String?
  capturedAt                 DateTime
  observedAt                 DateTime         @default(now())
  reasonCode                 String           @default("stale_archive")
  eligibleForChangeDetection Boolean          @default(false)
  createdAt                  DateTime         @default(now())

  @@unique([policyId, source, capturedAt])
  @@index([policyId, capturedAt])
  @@index([sourceRetrievalId])
}

model PolicySnapshot {
  id             String   @id @default(uuid())
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version        Int
  text           String
  hash           String
  publicEvidence Boolean  @default(false)
  createdAt      DateTime @default(now())

  oldChanges PolicyChange[] @relation("OldSnapshot")
  newChanges PolicyChange[] @relation("NewSnapshot")

  @@index([policyId])
}

model PolicyChange {
  id                String          @id @default(uuid())
  policyId          String
  policy            Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  oldSnapshotId     String?
  oldSnapshot       PolicySnapshot? @relation("OldSnapshot", fields: [oldSnapshotId], references: [id], onDelete: SetNull)
  newSnapshotId     String
  newSnapshot       PolicySnapshot  @relation("NewSnapshot", fields: [newSnapshotId], references: [id], onDelete: Cascade)
  diff              String // JSON array of diff chunks
  aiSummaryEn       String // Gemini executive summary in English
  aiSummaryIt       String // Gemini executive summary in Italian
  tldrEn            String? // ONE-sentence takeaway (EN)
  tldrIt            String? // ONE-sentence takeaway (IT)
  keyPointsJson     String? // JSON array of {textEn,textIt,sentiment}
  riskReasonsJson   String? // JSON array of {icon,textEn,textIt,deltaScore}
  overallRisk       String // "Low", "Medium", "High"
  overallScore      Int // 1-10 scale
  remediationsJson  String // JSON array of remediations
  publicEvidence    Boolean         @default(false)
  publicPublishedAt DateTime?

  // AI Governance Indicators (legacy, kept for compatibility)
  aiTrainingOptOut         String // "Allowed", "Not Allowed", "Opt-out available"
  aiDataScrapingRestricted String // "Restricted", "Permitted", "Not specified"
  aiIpLicensing            String // "Company retained", "Protected", "Shared"
  aiPromptRetention        String // "30 days", "Indefinite", "System-deleted"

  // Privacy & Data Protection KPIs (5)
  kpiDataCollection      String @default("Not assessed")
  kpiThirdPartySharing   String @default("Not assessed")
  kpiDataRetention       String @default("Not assessed")
  kpiRightToDeletion     String @default("Not assessed")
  kpiCrossBorderTransfer String @default("Not assessed")

  // AI Governance KPIs (5)
  kpiAiTrainingOptOut  String @default("Not assessed")
  kpiAiOutputOwnership String @default("Not assessed")
  kpiAlgoTransparency  String @default("Not assessed")
  kpiAutomatedDecision String @default("Not assessed")
  kpiAiBiasFairness    String @default("Not assessed")

  // Ethics & Corporate Governance KPIs (5)
  kpiConsentMechanism     String @default("Not assessed")
  kpiRegulatoryCompliance String @default("Not assessed")
  kpiBreachNotification   String @default("Not assessed")
  kpiIndependentAudit     String @default("Not assessed")
  kpiContentModeration    String @default("Not assessed")

  createdAt         DateTime          @default(now())
  regionImpacts     RegionImpact[]
  reviewLogs        AdminReviewLog[]
  webhookDeliveries WebhookDelivery[]

  @@index([policyId])
  @@index([createdAt])
  @@index([publicPublishedAt])
}

model WebhookDelivery {
  id             String                   @id @default(uuid())
  endpointId     String
  eventId        String
  changeId       String
  policyChange   PolicyChange             @relation(fields: [changeId], references: [id], onDelete: Cascade)
  occurredAt     DateTime
  status         String                   @default("pending") // pending, processing, retry, delivered, failed
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  lastStatusCode Int?
  lastErrorCode  String?
  deliveredAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  attempts       WebhookDeliveryAttempt[]

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([changeId])
}

model WebhookDeliveryAttempt {
  id            String          @id @default(uuid())
  deliveryId    String
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int
  outcome       String // delivered, retry, failed
  statusCode    Int?
  errorCode     String?
  durationMs    Int?
  attemptedAt   DateTime
  completedAt   DateTime        @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, attemptedAt])
  @@index([outcome, attemptedAt])
}

model DatasetQaIssueReview {
  id             String   @id @default(uuid())
  issueKey       String   @unique
  status         String   @default("open") // "open", "reviewed", "ignored"
  severity       String
  area           String
  entityType     String
  entityId       String?
  companyName    String?
  policyName     String?
  label          String
  detail         String
  action         String
  reason         String?
  reviewedByRole String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([area])
  @@index([entityType, entityId])
}

model AdminReviewLog {
  id             String        @id @default(uuid())
  actorRole      String
  action         String
  targetType     String
  targetId       String?
  targetLabel    String?
  oldValue       String?
  newValue       String?
  note           String?
  metadataJson   String?
  policyChangeId String?
  policyChange   PolicyChange? @relation(fields: [policyChangeId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([policyChangeId])
}

model SourceOnboardingBatch {
  id              String                 @id @default(uuid())
  label           String
  actorRole       String
  status          String                 @default("Active") // Active, Partial, Completed, Failed
  totalItems      Int                    @default(0)
  successfulItems Int                    @default(0)
  failedItems     Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  completedAt     DateTime?
  items           SourceOnboardingItem[]

  @@index([createdAt])
  @@index([status])
}

model SourceOnboardingItem {
  id                   String                    @id @default(uuid())
  batchId              String
  batch                SourceOnboardingBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber            Int
  companyName          String
  companySlug          String
  industry             String
  website              String
  policyName           String
  policyType           String
  policyUrl            String
  jurisdiction         String                    @default("Global")
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  discoveryCandidateId String?
  discoveryCandidate   PolicyDiscoveryCandidate? @relation(fields: [discoveryCandidateId], references: [id], onDelete: SetNull)
  policyId             String?
  policy               Policy?                   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  stage                String                    @default("Proposed") // Proposed, OfficialReview, BaselinePending, QaReview, Ready, Published, Held, Rejected, Failed
  qaStatus             String                    @default("Pending") // Pending, Pass, Fail
  qaSummary            String?
  qaChecksJson         String?
  publicationDecision  String                    @default("Pending") // Pending, Published, Held, Rejected
  reviewedByRole       String?
  reviewedAt           DateTime?
  decisionByRole       String?
  decisionAt           DateTime?
  error                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([batchId, rowNumber])
  @@index([batchId, stage])
  @@index([companyId])
  @@index([discoveryCandidateId])
  @@index([policyId])
  @@index([qaStatus])
  @@index([publicationDecision])
}

model AdminAccessLog {
  id        String   @id @default(uuid())
  event     String // "login_success", "login_failed", "logout", "session_invalid", "config_error"
  username  String?
  actorRole String?
  ipAddress String?
  userAgent String?
  path      String?
  method    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([username])
  @@index([ipAddress])
}

model PressMetricEvent {
  eventType String
  target    String
  locale    String
  createdAt DateTime @id

  @@index([eventType, createdAt])
  @@index([eventType, target, createdAt])
}

model AdminDashboardMetricEvent {
  id            String   @id @default(uuid())
  visitId       String
  eventType     String
  eventKey      String
  actorRole     String
  priorityId    String?
  destination   String?
  numericValue  Int?
  viewportClass String
  createdAt     DateTime @default(now())

  @@unique([visitId, eventKey])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model AiModelInvocation {
  id               String   @id @default(uuid())
  traceId          String
  operation        String
  provider         String   @default("google")
  modelId          String
  attempt          Int
  fallbackUsed     Boolean  @default(false)
  outcome          String
  errorCode        String?
  durationMs       Int
  inputChars       Int
  outputChars      Int?
  promptTokenCount Int?
  outputTokenCount Int?
  totalTokenCount  Int?
  schemaVersion    String?
  promptVersion    String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([operation, createdAt])
  @@index([modelId, outcome, createdAt])
  @@index([traceId])
}

model RegionImpact {
  id               String       @id @default(uuid())
  policyChangeId   String
  policyChange     PolicyChange @relation(fields: [policyChangeId], references: [id], onDelete: Cascade)
  region           String // "EU", "US", "Global"
  perspective      String // "Individual", "Enterprise"
  impactAnalysisEn String
  impactAnalysisIt String
  riskLevel        String // "Low", "Medium", "High"
  complianceNoteEn String?
  complianceNoteIt String?

  @@index([policyChangeId])
}

model Subscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  regions          String // Comma-separated: "EU,US,Global"
  industries       String // Comma-separated: "Tech Giant,FinTech"
  frequency        String   @default("INSTANT") // "INSTANT" or "WEEKLY"
  unsubscribeToken String   @unique @default(uuid())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
