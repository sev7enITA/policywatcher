datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logo      String? // Hex color for brand identity
  industry  String // "Tech Giant" or "FinTech"
  website   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  policies  Policy[]
  policyDiscoveryCandidates PolicyDiscoveryCandidate[]
  sourceOnboardingItems SourceOnboardingItem[]
}

model PolicyDiscoveryCandidate {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  type              String
  url               String
  jurisdiction      String   @default("Global")
  confidence        Int
  discoverySource   String
  retrievalSource   String
  reason            String
  diagnosticsJson   String?
  status            String   @default("Proposed") // Proposed, Approved, Rejected
  reviewedAt        DateTime?
  reviewedByRole    String?
  createdPolicyId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sourceOnboardingItems SourceOnboardingItem[]

  @@unique([companyId, url, type, jurisdiction])
  @@index([companyId, status])
  @@index([createdAt])
}

model Policy {
  id                      String           @id @default(uuid())
  companyId               String
  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String // e.g. "Privacy Policy", "Terms of Service"
  type                    String // e.g. "privacy", "terms", "ai", "acceptable-use"
  url                     String
  jurisdiction            String           @default("Global") // "EU", "US", "UK", "Global", etc.
  currentText             String
  currentHash             String
  dataStatus              String           @default("Available") // "Configured", "Available", "Partial", "Needs Review", "Unavailable", "Reviewed"
  lastCheckDate           DateTime         @default(now())
  lastSuccessfulCheckDate DateTime         @default(now())
  ingestionMethod         String           @default("Seeded") // "Seeded", "Direct Scrape", "Wayback Cache", etc.
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  snapshots               PolicySnapshot[]
  changes                 PolicyChange[]
  checkLogs               PolicyCheckLog[]
  sourceOnboardingItems   SourceOnboardingItem[]

  @@unique([companyId, type, jurisdiction])
  @@index([companyId])
  @@index([jurisdiction])
}

model PolicyCheckLog {
  id         String   @id @default(uuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status     String // "Available", "Needs Review", "Unavailable", "Partial", "Configured", "Reviewed"
  checkedAt  DateTime @default(now())
  source     String? // "direct", "http2", "wayback", "cache", "commoncrawl", "seeded", "none"
  httpStatus Int?
  reason     String?
  finalUrl   String?
  textHash   String?
  textLength Int?
  archiveTimestamp DateTime?
  createdAt  DateTime @default(now())

  @@index([policyId])
  @@index([checkedAt])
  @@index([status])
}

model PolicySnapshot {
  id             String   @id @default(uuid())
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version        Int
  text           String
  hash           String
  publicEvidence Boolean  @default(false)
  createdAt      DateTime @default(now())

  oldChanges PolicyChange[] @relation("OldSnapshot")
  newChanges PolicyChange[] @relation("NewSnapshot")

  @@index([policyId])
}

model PolicyChange {
  id               String          @id @default(uuid())
  policyId         String
  policy           Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  oldSnapshotId    String?
  oldSnapshot      PolicySnapshot? @relation("OldSnapshot", fields: [oldSnapshotId], references: [id], onDelete: SetNull)
  newSnapshotId    String
  newSnapshot      PolicySnapshot  @relation("NewSnapshot", fields: [newSnapshotId], references: [id], onDelete: Cascade)
  diff             String // JSON array of diff chunks
  aiSummaryEn      String // Gemini executive summary in English
  aiSummaryIt      String // Gemini executive summary in Italian
  tldrEn           String? // ONE-sentence takeaway (EN)
  tldrIt           String? // ONE-sentence takeaway (IT)
  keyPointsJson    String? // JSON array of {textEn,textIt,sentiment}
  riskReasonsJson  String? // JSON array of {icon,textEn,textIt,deltaScore}
  overallRisk      String // "Low", "Medium", "High"
  overallScore     Int // 1-10 scale
  remediationsJson String // JSON array of remediations
  publicEvidence   Boolean @default(false)

  // AI Governance Indicators (legacy, kept for compatibility)
  aiTrainingOptOut         String // "Allowed", "Not Allowed", "Opt-out available"
  aiDataScrapingRestricted String // "Restricted", "Permitted", "Not specified"
  aiIpLicensing            String // "Company retained", "Protected", "Shared"
  aiPromptRetention        String // "30 days", "Indefinite", "System-deleted"

  // Privacy & Data Protection KPIs (5)
  kpiDataCollection      String @default("Not assessed")
  kpiThirdPartySharing   String @default("Not assessed")
  kpiDataRetention       String @default("Not assessed")
  kpiRightToDeletion     String @default("Not assessed")
  kpiCrossBorderTransfer String @default("Not assessed")

  // AI Governance KPIs (5)
  kpiAiTrainingOptOut  String @default("Not assessed")
  kpiAiOutputOwnership String @default("Not assessed")
  kpiAlgoTransparency  String @default("Not assessed")
  kpiAutomatedDecision String @default("Not assessed")
  kpiAiBiasFairness    String @default("Not assessed")

  // Ethics & Corporate Governance KPIs (5)
  kpiConsentMechanism     String @default("Not assessed")
  kpiRegulatoryCompliance String @default("Not assessed")
  kpiBreachNotification   String @default("Not assessed")
  kpiIndependentAudit     String @default("Not assessed")
  kpiContentModeration    String @default("Not assessed")

  createdAt     DateTime         @default(now())
  regionImpacts RegionImpact[]
  reviewLogs    AdminReviewLog[]

  @@index([policyId])
  @@index([createdAt])
}

model DatasetQaIssueReview {
  id             String   @id @default(uuid())
  issueKey       String   @unique
  status         String   @default("open") // "open", "reviewed", "ignored"
  severity       String
  area           String
  entityType     String
  entityId       String?
  companyName    String?
  policyName     String?
  label          String
  detail         String
  action         String
  reason         String?
  reviewedByRole String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([area])
  @@index([entityType, entityId])
}

model AdminReviewLog {
  id             String        @id @default(uuid())
  actorRole      String
  action         String
  targetType     String
  targetId       String?
  targetLabel    String?
  oldValue       String?
  newValue       String?
  note           String?
  metadataJson   String?
  policyChangeId String?
  policyChange   PolicyChange? @relation(fields: [policyChangeId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([policyChangeId])
}

model SourceOnboardingBatch {
  id              String   @id @default(uuid())
  label           String
  actorRole       String
  status          String   @default("Active") // Active, Partial, Completed, Failed
  totalItems      Int      @default(0)
  successfulItems Int      @default(0)
  failedItems     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?
  items           SourceOnboardingItem[]

  @@index([createdAt])
  @@index([status])
}

model SourceOnboardingItem {
  id                   String                    @id @default(uuid())
  batchId              String
  batch                SourceOnboardingBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber            Int
  companyName          String
  companySlug          String
  industry             String
  website              String
  policyName           String
  policyType           String
  policyUrl            String
  jurisdiction         String                    @default("Global")
  companyId            String?
  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  discoveryCandidateId String?
  discoveryCandidate   PolicyDiscoveryCandidate? @relation(fields: [discoveryCandidateId], references: [id], onDelete: SetNull)
  policyId             String?
  policy               Policy?                   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  stage                 String                    @default("Proposed") // Proposed, OfficialReview, BaselinePending, QaReview, Ready, Published, Held, Rejected, Failed
  qaStatus              String                    @default("Pending") // Pending, Pass, Fail
  qaSummary             String?
  qaChecksJson          String?
  publicationDecision  String                    @default("Pending") // Pending, Published, Held, Rejected
  reviewedByRole        String?
  reviewedAt            DateTime?
  decisionByRole        String?
  decisionAt            DateTime?
  error                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([batchId, rowNumber])
  @@index([batchId, stage])
  @@index([companyId])
  @@index([discoveryCandidateId])
  @@index([policyId])
  @@index([qaStatus])
  @@index([publicationDecision])
}

model AdminAccessLog {
  id              String   @id @default(uuid())
  event           String // "login_success", "login_failed", "logout", "session_invalid", "config_error"
  username        String?
  actorRole       String?
  ipAddress       String?
  userAgent       String?
  path            String?
  method          String?
  detail          String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([username])
  @@index([ipAddress])
}

model RegionImpact {
  id               String       @id @default(uuid())
  policyChangeId   String
  policyChange     PolicyChange @relation(fields: [policyChangeId], references: [id], onDelete: Cascade)
  region           String // "EU", "US", "Global"
  perspective      String // "Individual", "Enterprise"
  impactAnalysisEn String
  impactAnalysisIt String
  riskLevel        String // "Low", "Medium", "High"
  complianceNoteEn String?
  complianceNoteIt String?

  @@index([policyChangeId])
}

model Subscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  regions          String // Comma-separated: "EU,US,Global"
  industries       String // Comma-separated: "Tech Giant,FinTech"
  frequency        String   @default("INSTANT") // "INSTANT" or "WEEKLY"
  unsubscribeToken String   @unique @default(uuid())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
