<!--
  PolicyWatcher Enterprise API v2 - API Management inbound policy template.

  Required named values:
  - entra-tenant-id: pilot Entra tenant UUID
  - policywatcher-api-audience: API client ID or Application ID URI
  - policywatcher-backend-url: HTTPS PolicyWatcher origin
  - policywatcher-backend-shared-secret: secret named value, never exposed to clients

  The origin validates signature, tenant, audience, and scope/application role
  again. Do not remove origin authentication after enabling this policy.
-->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token
      tenant-id="{{entra-tenant-id}}"
      header-name="Authorization"
      failed-validation-httpcode="401"
      failed-validation-error-message="Invalid Microsoft Entra access token.">
      <audiences>
        <audience>{{policywatcher-api-audience}}</audience>
      </audiences>
    </validate-azure-ad-token>
    <set-header name="X-Request-Id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <set-header name="X-PolicyWatcher-Gateway-Key" exists-action="override">
      <value>{{policywatcher-backend-shared-secret}}</value>
    </set-header>
    <rate-limit-by-key
      calls="300"
      renewal-period="60"
      counter-key="@(context.Subscription?.Id ?? context.Request.IpAddress)" />
    <set-backend-service base-url="{{policywatcher-backend-url}}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Content-Type-Options" exists-action="override">
      <value>nosniff</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
