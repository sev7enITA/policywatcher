digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.28", ranksep="0.52", splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cbd5e1", fontname="Arial", fontsize=12, margin="0.17,0.12"];
edge [color="#8593ab", arrowsize="0.7", fontname="Arial", fontsize=10];
entry [id="overview--entry", label="1. Richiesta autorizzata", fillcolor="#ffffff", shape="box"];
queue [id="overview--queue", label="2. Coda persistente e lease", fillcolor="#eaf2ff", shape="box"];
capture [id="overview--capture", label="3. Acquisizione e artefatto\nprivato", fillcolor="#ffffff", shape="box"];
checks [id="overview--checks", label="4. Identità, inventario V2, link\ne prove", fillcolor="#ffffff", shape="diamond"];
hold [id="overview--hold", label="Sospensione: prove mancanti o\nincerte", fillcolor="#fff3dd", shape="box"];
private [id="overview--private", label="Observe: risultati privati", fillcolor="#e6f8f5", shape="box"];
confirm [id="overview--confirm", label="5. Contesto, conferma e\nconfronto", fillcolor="#ffffff", shape="box"];
waiting [id="overview--waiting", label="Attesa altra cattura: task\ncompletato, non fonte\nqualificata", fillcolor="#fff3dd", shape="box"];
mode [id="overview--mode", label="Modalità del run", fillcolor="#ffffff", shape="diamond"];
models [id="overview--models", label="6. Analista, span e verificatore", fillcolor="#ffffff", shape="box"];
review [id="overview--review", label="Revisione: impatto alto o esito\nincerto", fillcolor="#fff3dd", shape="box"];
publication [id="overview--publication", label="7. Gate pubblicabile: V2 e zero\nallegati", fillcolor="#ecebff", shape="diamond"];
commit [id="overview--commit", label="8. Transazione DB: snapshot,\nchange, claim, graph/evento\nopzionali", fillcolor="#eaf2ff", shape="box"];
notify [id="overview--notify", label="9. Outbox separata: consenso e\nconsegna", fillcolor="#ffffff", shape="box"];
entry -> queue [label="", style="solid"];
queue -> capture [label="", style="solid"];
capture -> checks [label="", style="solid"];
checks -> hold [label="non idoneo alla modalità\nrichiesta", style="solid"];
checks -> confirm [label="parent modificato e\nconfrontabile", style="solid"];
confirm -> waiting [label="conferma non ancora\ndisponibile", style="solid"];
confirm -> models [label="confermato; delta non solo\nformattazione", style="solid"];
models -> review [label="hold richiesto", style="solid"];
models -> mode [label="span e verifica superati", style="solid"];
mode -> private [label="observe", style="solid"];
mode -> publication [label="publish: ricontrollo di tutti\ni gate", style="solid"];
publication -> hold [label="non pubblicabile", style="solid"];
publication -> commit [label="prove sufficienti e contesto\nvalido", style="solid"];
commit -> notify [label="solo notifiche abilitate", style="solid"];
}
