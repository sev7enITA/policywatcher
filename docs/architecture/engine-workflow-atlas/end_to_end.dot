Confirm [id="end_to_end--Confirm", label="Second matching fresh response\nin another run?", fillcolor="#ffffff", shape="diamond"];
Candidate [id="end_to_end--Candidate", label="Store candidate; complete task\nas confirmation pending", fillcolor="#fff3dd", shape="box"];
Initial [id="end_to_end--Initial", label="Observe or publish?", fillcolor="#ffffff", shape="diamond"];
