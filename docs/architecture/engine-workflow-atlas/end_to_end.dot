PublicBaseline [id="end_to_end--PublicBaseline", label="Snapshot and baseline; no change\nalert", fillcolor="#ecebff", shape="box"];
Deltas [id="end_to_end--Deltas", label="Compare structured parent-\ndocument blocks", fillcolor="#ffffff", shape="box"];
Analyze [id="end_to_end--Analyze", label="Model analyst", fillcolor="#ffffff", shape="box"];
Verify [id="end_to_end--Verify", label="Separate model verifier", fillcolor="#fff3dd", shape="box"];
Commit [id="end_to_end--Commit", label="Run mode", fillcolor="#ffffff", shape="diamond"];
