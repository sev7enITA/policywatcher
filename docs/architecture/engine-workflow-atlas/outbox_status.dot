digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.18", nodesep="0.28", ranksep="0.52", splines=polyline];
node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cbd5e1", fontname="Arial", fontsize=12, margin="0.17,0.12"];
edge [color="#8593ab", arrowsize="0.7", fontname="Arial", fontsize=10];
start [id="outbox_status--start", label="start", fillcolor="#eaf2ff", shape="box"];
pending [id="outbox_status--pending", label="pending", fillcolor="#fff3dd", shape="box"];
sending [id="outbox_status--sending", label="sending", fillcolor="#eaf2ff", shape="box"];
delivered [id="outbox_status--delivered", label="delivered", fillcolor="#eaf2ff", shape="box"];
failed [id="outbox_status--failed", label="failed", fillcolor="#fff3dd", shape="box"];
start -> pending [label="O01 optional event inside\npublication DB transaction", style="solid"];
pending -> sending [label="O02 CAS lease claim", style="solid"];
sending -> delivered [label="O03 root fanout committed /\nrecipient ack or skip", style="solid"];
sending -> pending [label="O04 retryable failure /\nexpired lease below 5 attempts", style="solid"];
sending -> failed [label="O05 attempts exhausted", style="solid"];
}
