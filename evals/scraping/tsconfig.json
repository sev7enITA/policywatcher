{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals",
      "next"
    ]
  },
  "include": [
    "../../src/lib/adaptiveAcquisition/**/*.ts",
    "../../src/lib/__tests__/adaptiveAcquisition.test.ts",
    "../../scripts/scraping-*.ts"
  ]
}
